<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <AssemblyName>MyGameConsole</AssemblyName>
    <RootNamespace>MyGameConsole</RootNamespace>
    <Product>My Game Console</Product>
    <Company>Leonardo</Company>
    <!-- Versão do app (Major.Minor.Patch). É a fonte da versão do MSI, da tag da release (v1.0.0) e da checagem de atualização. -->
    <Version>1.0.5</Version>
    <!-- Sem o sufixo "+hash" na versão informativa: a versão exibida e comparada com as releases é só Major.Minor.Patch. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Necessário para o gerador de código do LibraryImport (P/Invoke moderno). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\app.ico" LogicalName="app.ico" />
    <!-- Papel de parede padrão do Modo Game: vai junto com o app (e com o instalador). -->
    <Content Include="..\..\img\wallpaper.webp" Link="wallpaper.webp" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
